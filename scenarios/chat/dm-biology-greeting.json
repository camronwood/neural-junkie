{
  "name": "dm-biology-greeting",
  "description": "BiologyExpert DM greeting (requires life-sciences pack).",
  "tags": ["dm", "biology", "greeting", "life-sciences"],
  "optional": true,
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "BiologyExpert",
  "required_agents": ["BiologyExpert"],
  "steps": [
    {
      "action": "send",
      "content": "hello",
      "metadata": { "conversation_mode": "chat", "context_scope": "none" }
    },
    { "action": "wait_reply", "from": "BiologyExpert", "timeout": "90s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "BiologyExpert",
      "none_match": ["MCP", "summarize_scan_analysis"],
      "max_chars": 1200
    }
  ],
  "cleanup": "clear"
}
