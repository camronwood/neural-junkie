{
  "name": "casual-opinion-chat",
  "description": "Chat mode opinion question should not dump workspace/tool blocks.",
  "channel": "chat-scenarios",
  "channel_type": "public",
  "mention": "@Assistant",
  "required_agents": ["Assistant"],
  "steps": [
    {
      "action": "send",
      "content": "what do you think about golang?",
      "metadata": {
        "conversation_mode": "chat",
        "context_scope": "none"
      }
    },
    {
      "action": "wait_reply",
      "from": "Assistant",
      "timeout": "90s"
    },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "Assistant",
      "none_match": ["Grounding: I loaded", "FILE_CHANGE", "kubectl apply"]
    }
  ],
  "cleanup": "clear"
}
