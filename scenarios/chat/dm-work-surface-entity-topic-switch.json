{
  "name": "dm-work-surface-entity-topic-switch",
  "description": "Work-surface: introduce DisplayPreferences, switch topic, then retain the named entity.",
  "tags": ["dm", "frontend", "long-horizon", "work-surface", "regression"],
  "evaluation": {"long_horizon": true, "min_user_turns": 4},
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "We are adding a DisplayPreferences panel. Should we use a segmented control or a single toggle?",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s"},
    {
      "action": "send",
      "content": "Use the single toggle. Also, what font stack should Settings use?",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s"},
    {
      "action": "send",
      "content": "Anyway, forget fonts for a second — how far is Collinsville from St Louis?",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s"},
    {
      "action": "send",
      "content": "Back to the product: remind me of the DisplayPreferences control we chose.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s"},
    {
      "action": "assert_transcript_metrics",
      "cases": [
        {
          "metric": "instruction_retention",
          "user_match": "DisplayPreferences",
          "after_user_match": "Back to the product",
          "assistant_match": "DisplayPreferences"
        },
        {
          "metric": "instruction_retention",
          "user_match": "single toggle",
          "after_user_match": "Back to the product",
          "assistant_match": "(?i)toggle"
        },
        {
          "metric": "stale_plan",
          "user_match": "Use the single toggle",
          "stale_match": "(?i)(chose|final|we picked).{0,30}segmented"
        }
      ],
      "thresholds": {
        "instruction_retention_rate": 1.0,
        "stale_plan_rate": 0.0
      }
    }
  ],
  "cleanup": "clear"
}
