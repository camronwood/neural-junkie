{
  "name": "public-frontend-theme-continuation",
  "description": "FrontendEngineer: theme ask then go-ahead keeps code context (no path begging).",
  "tags": ["public", "frontend", "workspace", "regression"],
  "channel": "chat-scenarios",
  "channel_type": "public",
  "mention": "@FrontendEngineer",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": {
    "fixture": "react-tailwind-minimal",
    "file_tree": "src/App.tsx\nsrc/main.tsx\ntailwind.config.js\npackage.json\n",
    "open_files": ["src/App.tsx", "tailwind.config.js"]
  },
  "steps": [
    {
      "action": "send",
      "content": "I want to add UI themes under settings with light and dark modes",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s" },
    {
      "action": "send",
      "content": "yes please go ahead",
      "metadata": {
        "conversation_mode": "code",
        "context_scope": "outline",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_mode": "agent",
        "editor_agent_trust": "auto_apply_edits"
      }
    },
    { "action": "wait_reply", "from": "FrontendEngineer", "timeout": "180s", "accept_file_change": true },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "FrontendEngineer",
      "none_match": [
        "provide the path",
        "path to your main",
        "path to the main",
        "which file",
        "eslint.config"
      ]
    }
  ],
  "cleanup": "clear"
}
