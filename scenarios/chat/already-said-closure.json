{
  "name": "already-said-closure",
  "description": "User says the agent already answered; expect canned won't-repeat style closure.",
  "tags": [
    "public",
    "assistant",
    "closure",
    "regression"
  ],
  "channel": "chat-scenarios",
  "channel_type": "public",
  "mention": "@Assistant",
  "required_agents": [
    "Assistant"
  ],
  "steps": [
    {
      "action": "send",
      "content": "What is 2+2?"
    },
    {
      "action": "wait_reply",
      "from": "Assistant",
      "timeout": "180s"
    },
    {
      "action": "send",
      "content": "I know you said that already"
    },
    {
      "action": "wait_reply",
      "from": "Assistant",
      "timeout": "45s",
      "retries": 1
    },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "Assistant",
      "any_match": [
        "won't repeat|won\u2019t repeat|What would you like|anything else"
      ],
      "optional": true,
      "max_chars": 180,
      "none_match": [
        "2\\s*\\+\\s*2\\s*=\\s*4"
      ]
    }
  ],
  "cleanup": "clear"
}
