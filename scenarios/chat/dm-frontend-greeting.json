{
  "name": "dm-frontend-greeting",
  "description": "FrontendEngineer DM greeting stays short without tooling dumps.",
  "tags": ["dm", "frontend", "greeting"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "hello",
      "metadata": { "conversation_mode": "chat", "context_scope": "none" }
    },
    { "action": "wait_reply", "from": "FrontendEngineer", "timeout": "90s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "FrontendEngineer",
      "none_match": ["MCP", "FILE_CHANGE", "kubectl"],
      "max_chars": 1200
    }
  ],
  "cleanup": "clear"
}
