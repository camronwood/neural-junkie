{
  "name": "dm-backend-codebase-semantic",
  "description": "BackendEngineer DM: @codebase finds symbol in non-obvious filename via semantic/keyword index.",
  "tags": ["dm", "backend", "codebase", "regression"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "BackendEngineer",
  "required_agents": ["BackendEngineer"],
  "workspace": {
    "fixture": "minimal-repo",
    "file_tree": "core/sample/main.go\ncore/obscure/internal/widget.go\n"
  },
  "steps": [
    {
      "action": "send",
      "content": "@codebase What does ComputeObscureWidget return?",
      "metadata": { "conversation_mode": "code", "context_scope": "focus" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "120s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "BackendEngineer",
      "any_match": ["\\b42\\b"],
      "none_match": ["golang.org/x/", "I cannot see", "no workspace", "boolean"]
    }
  ],
  "cleanup": "clear"
}
