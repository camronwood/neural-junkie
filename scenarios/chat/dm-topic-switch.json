{
  "name": "dm-topic-switch",
  "description": "BackendEngineer DM: code task → casual chat opinion → back to code must not dump workspace blocks on the chat turn.",
  "tags": ["dm", "backend", "topic-switch", "regression"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "BackendEngineer",
  "required_agents": ["BackendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "review internal/hub/hub.go for error handling gaps",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "120s" },
    {
      "action": "send",
      "content": "what do you think about go vs rust for backend services?",
      "metadata": { "conversation_mode": "chat", "context_scope": "none" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "90s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "BackendEngineer",
      "none_match": ["Grounding: I loaded", "FILE_CHANGE", "kubectl apply"]
    },
    {
      "action": "send",
      "content": "now outline the hook changes you'd make in hub.go for better errors",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "120s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "BackendEngineer",
      "none_match": [
        "provide the path",
        "which file should I",
        "path to your main"
      ]
    }
  ],
  "cleanup": "clear"
}
