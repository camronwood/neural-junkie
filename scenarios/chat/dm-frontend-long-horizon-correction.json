{
  "name": "dm-frontend-long-horizon-correction",
  "description": "Retain an early UI constraint across correction, interruption, and prior-assistant reference turns.",
  "tags": ["dm", "frontend", "metrics", "long-horizon", "regression"],
  "evaluation": {"long_horizon": true, "min_user_turns": 4},
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "Design a theme settings flow. Keep the toggle in an Appearance section and call the component ThemeSettings.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "send",
      "content": "Add keyboard accessibility and explain the focus behavior.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "send",
      "content": "Correction: rename the component to DisplayPreferences, but keep the Appearance placement.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "send",
      "content": "Continue from your accessibility answer after that correction and summarize the final design.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "assert_transcript_metrics",
      "cases": [
        {"metric": "direct_answer", "user_match": "Design a theme settings flow", "assistant_match": "(Appearance|ThemeSettings|toggle)"},
        {"metric": "repeated_question", "assistant_match": "(?i)shall i|would you like|do you want me to"},
        {"metric": "correction_recovery", "user_match": "Correction", "assistant_match": "DisplayPreferences"},
        {
          "metric": "instruction_retention",
          "user_match": "Keep the toggle in an Appearance",
          "after_user_match": "Continue from your accessibility",
          "assistant_match": "Appearance"
        },
        {"metric": "correction_latency", "user_match": "Correction", "assistant_match": "DisplayPreferences"},
        {"metric": "stale_plan", "user_match": "Correction", "stale_match": "(final|component).*ThemeSettings"}
      ],
      "thresholds": {
        "direct_answer_rate": 1.0,
        "repeated_question_rate": 0.0,
        "correction_recovery_rate": 1.0,
        "instruction_retention_rate": 1.0,
        "correction_latency_turns": 1.0,
        "stale_plan_rate": 0.0
      }
    }
  ],
  "cleanup": "clear"
}
