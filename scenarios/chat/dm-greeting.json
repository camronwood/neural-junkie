{
  "name": "dm-greeting",
  "description": "Real DM channel greeting stays conversational without tooling dumps.",
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "Assistant",
  "required_agents": ["Assistant"],
  "steps": [
    {
      "action": "send",
      "content": "hello",
      "metadata": {
        "conversation_mode": "chat",
        "context_scope": "none"
      }
    },
    {
      "action": "wait_reply",
      "from": "Assistant",
      "timeout": "90s"
    },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "Assistant",
      "none_match": ["MCP", "FILE_CHANGE", "kubectl"],
      "max_chars": 1200
    }
  ],
  "cleanup": "clear"
}
