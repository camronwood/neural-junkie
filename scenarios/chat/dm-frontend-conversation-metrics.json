{
  "name": "dm-frontend-conversation-metrics",
  "description": "FrontendEngineer answers a placement question and incorporates a corrected component name.",
  "tags": ["dm", "frontend", "metrics", "regression"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "Where should a light and dark theme toggle live in a settings UI?",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "send",
      "content": "Correction: refer to the component as ThemeSettings, not SettingsPanel.",
      "metadata": {"conversation_mode": "chat", "context_scope": "none"}
    },
    {"action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s"},
    {
      "action": "assert_transcript_metrics",
      "cases": [
        {
          "metric": "direct_answer",
          "user_match": "Where should",
          "assistant_match": "\\b(settings|appearance|preferences|theme)\\b"
        },
        {
          "metric": "repeated_question",
          "assistant_match": "(theme|toggle|component)"
        },
        {
          "metric": "correction_recovery",
          "user_match": "Correction:.*ThemeSettings",
          "assistant_match": "ThemeSettings"
        }
      ],
      "thresholds": {
        "direct_answer_rate": 1.0,
        "repeated_question_rate": 0.0,
        "correction_recovery_rate": 1.0
      }
    }
  ],
  "cleanup": "clear"
}
