{
  "name": "dm-architect-outline",
  "description": "SoftwareArchitect DM repo structure question.",
  "tags": ["dm", "architecture", "substantive"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "SoftwareArchitect",
  "required_agents": ["SoftwareArchitect"],
  "steps": [
    {
      "action": "send",
      "content": "What is the architecture of this repo?",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "SoftwareArchitect", "timeout": "120s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "SoftwareArchitect",
      "none_match": ["MCP tool loop", "FILE_CHANGE"]
    }
  ],
  "cleanup": "clear"
}
