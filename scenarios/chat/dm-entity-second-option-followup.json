{
  "name": "dm-entity-second-option-followup",
  "description": "Frontend DM: offer two UI options then soft 'second option' follow-up must retain the thread without ask_user/tools.",
  "tags": [
    "dm",
    "frontend",
    "dialogue",
    "continuity",
    "regression"
  ],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "steps": [
    {
      "action": "send",
      "content": "For ThemeSettings, should we use a segmented control or a single toggle?",
      "metadata": {
        "conversation_mode": "chat",
        "context_scope": "none"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "120s"
    },
    {
      "action": "send",
      "content": "and what about the second option?",
      "metadata": {
        "conversation_mode": "chat",
        "context_scope": "none"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "120s"
    },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "FrontendEngineer",
      "any_match": [
        "toggle|segmented|ThemeSettings|option"
      ],
      "none_match": [
        "FILE_CHANGE",
        "Grounding: I loaded",
        "which file should I",
        "provide the path",
        "kubectl"
      ]
    },
    {
      "action": "assert_messages",
      "semantic_turn_decision": {
        "optional": true,
        "user_match": "and what about the second option",
        "action": "answer",
        "mutation": "none"
      }
    },
    {
      "action": "send",
      "content": "why?",
      "metadata": {
        "conversation_mode": "chat",
        "context_scope": "none"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "120s"
    },
    {
      "action": "assert_messages",
      "semantic_turn_decision": {
        "optional": true,
        "user_match": "why?",
        "action": "answer",
        "mutation": "none"
      }
    }
  ],
  "cleanup": "clear"
}
