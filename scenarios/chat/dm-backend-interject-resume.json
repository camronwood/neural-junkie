{
  "name": "dm-backend-interject-resume",
  "description": "BackendEngineer DM: channel interject holds agents until the user sends again; resume must answer the new question (hub: make server-regression).",
  "tags": ["dm", "backend", "interject", "regression"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "BackendEngineer",
  "required_agents": ["BackendEngineer"],
  "workspace": {
    "fixture": "minimal-repo",
    "open_files": ["core/sample/main.go"],
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "steps": [
    {
      "action": "send",
      "content": "What does the main function in the open file do?",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "120s" },
    { "action": "channel_interject", "retries": 1 },
    {
      "action": "wait_no_reply",
      "from": "BackendEngineer",
      "duration": "8s",
      "retries": 1,
      "reinterject_on_retry": true
    },
    {
      "action": "send",
      "content": "What package is that file in?",
      "metadata": { "conversation_mode": "code", "context_scope": "outline" }
    },
    { "action": "wait_reply", "from": "BackendEngineer", "timeout": "120s" },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "BackendEngineer",
      "any_match": ["package main|main\\b|HelloWorld|sample/main"],
      "none_match": [
        "What does the main function",
        "go vet",
        "staticcheck"
      ]
    },
    {
      "action": "assert_reply_count",
      "from": "BackendEngineer",
      "count": 1,
      "since_baseline": true
    }
  ],
  "cleanup": "clear"
}
