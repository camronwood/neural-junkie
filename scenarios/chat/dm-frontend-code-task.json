{
  "name": "dm-frontend-code-task",
  "description": "FrontendEngineer DM code-mode component question routes as task.",
  "tags": ["dm", "frontend", "task", "debug"],
  "channel_type": "dm",
  "dm_user": "ChatScenario",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "steps": [
    {
      "action": "send",
      "content": "fix the React component in src/App.tsx",
      "metadata": { "conversation_mode": "code" }
    },
    { "action": "wait_reply", "from": "FrontendEngineer", "timeout": "120s" },
    {
      "action": "assert_debug_context",
      "message": "fix the React component in src/App.tsx",
      "conversation_mode": "code",
      "resolved_intent": "task",
      "optional": true
    },
    {
      "action": "assert_messages",
      "last_reply_only": true,
      "from": "FrontendEngineer",
      "none_match": ["MCP server list", "kubectl apply"]
    }
  ],
  "cleanup": "clear"
}
