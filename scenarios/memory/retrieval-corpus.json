      "source_types": [
        "collab_artifact"
      ],
      "limit": 5,
      "seed_chunks": [
        {
          "id": "findings:0",
          "source_type": "collab_artifact",
          "source_id": "findings",
          "channel": "ch-collab",
          "rel_path": "collabs/c1/findings.md",
          "content": "Decision: use JWT auth middleware for the hub API. Reject session cookies for agent DMs."
        },
        {
          "id": "findings:1",
          "source_type": "collab_artifact",
          "source_id": "findings",
          "channel": "ch-collab",
          "rel_path": "collabs/c1/findings.md",
          "content": "Follow-up: OAuth client credentials remain for pack marketplace only. Do not mix with JWT DM auth."
        },
        {
          "id": "noise:chat",
          "source_type": "message",
          "source_id": "noise",
          "channel": "ch-collab",
          "content": "auth middleware lunch notes unrelated"
        }
      ],
      "must_include_ids": [
        "findings:0",
        "findings:1"
      ],
      "must_exclude_ids": [
        "noise:chat"
      ]
    },
