{
  "name": "collab-generation-error-resilience",
  "description": "Executing collab should recover from a single agent timeout without JSON discussion or placeholder deliverables.",
  "tags": [
    "collab",
    "conversation",
    "regression",
    "optional"
  ],
  "optional": true,
  "channel": "collab-scenarios",
  "agents": "@BackendEngineer @SoftwareArchitect",
  "required_agents": [
    "BackendEngineer",
    "SoftwareArchitect"
  ],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "1",
      "--messages",
      "4"
    ],
    "goal": "@BackendEngineer @SoftwareArchitect Plan two tasks: Task 1 @BackendEngineer Write collabs/<id>/findings.md from README.md; Task 2 @SoftwareArchitect Write collabs/<id>/architecture-notes.md with two bullets on package layout."
  },
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 25
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 2,
      "max_tasks": 4,
      "tasks_have_file_deliverable": true
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 45
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "settle_only": true,
      "timeout": "180s"
    },
    {
      "action": "assert_messages",
      "phase": "executing",
      "deny_json_discussion": true,
      "none_match": [
        "\\[Insert File Name\\]",
        "insert issues"
      ]
    },
    {
      "action": "assert_collab",
      "phase_in": [
        "executing",
        "completed"
      ]
    }
  ],
  "cleanup": "cancel"
}
