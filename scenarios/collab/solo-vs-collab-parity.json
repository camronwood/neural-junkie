{
  "name": "solo-vs-collab-parity",
  "description": "Compare solo @Assistant deliverable vs collab execution on the same minimal-repo fixture.",
  "channel": "collab-scenarios",
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "solo_leg": {
    "channel": "collab-scenarios-solo",
    "output_rel": "collabs/parity-solo/findings.md",
    "timeout": "300s",
    "min_bytes": 40,
    "message": "@Assistant Write collabs/parity-solo/findings.md with three bullet findings about this repo using only README.md and core/sample/main.go. Use a [FILE_CHANGE] proposal or workspace write so the file exists on disk under collabs/parity-solo/findings.md.",
    "approve_timeout": "180s",
    "any_match": ["main\\.go", "core/sample", "minimal"],
    "none_match": ["index\\.js", "utils\\.js", "\\bapp\\.js\\b", "data handling module"]
  },
  "collaborate": {
    "flags": ["--workspace", "--rounds", "1", "--messages", "3"],
    "goal": "@ChatModerator @Assistant Plan one task: @Assistant writes collabs/<collab-id>/findings.md with three bullet findings about this repo (README.md and core/sample/main.go only). Use - Task 1: @Assistant - Write collabs/<collab-id>/findings.md"
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 40,
      "deny_task_status": true,
      "for_question": {
        "any_match": ["main\\.go", "core/sample", "minimal"],
        "none_match": ["index\\.js", "utils\\.js", "\\bapp\\.js\\b", "data handling module"]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 20},
    {"action": "wait_phase", "phase": "reviewing", "timeout": "180s"},
    {"action": "wait_planning_recap", "timeout": "120s"},
    {"action": "approve_plan"},
    {"action": "wait_phase", "phase": "executing", "timeout": 45},
    {
      "action": "wait_tasks",
      "min_completed": 1,
      "all_match": false,
      "timeout": "300s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "must_exist": true,
      "min_bytes": 40,
      "deny_task_status": true,
      "any_match": ["main\\.go", "core/sample", "minimal"],
      "none_match": ["index\\.js", "utils\\.js", "\\bapp\\.js\\b", "data handling module"]
    }
  ],
  "cleanup": "cancel"
}
