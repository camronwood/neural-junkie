{
  "name": "multi-collab-isolation",
  "description": "Planning collab still gets agent discussion while another collab is executing.",
  "channel": "collab-scenarios",
  "setup": {
    "action": "executing_blocker",
    "channel": "collab-scenario-blocker",
    "agents": "@BackendEngineer @SoftwareArchitect",
    "flags": ["--rounds", "1", "--messages", "4"],
    "goal": "hold executing slot for multi-collab isolation probe",
    "steps": [
      {"action": "wait_phase", "phase": "reviewing", "timeout": "240s"},
      {"action": "wait_planning_recap", "timeout": "180s"},
      {"action": "approve_plan"},
      {"action": "workspace_ack"},
      {"action": "wait_phase", "phase": "executing", "timeout": 60}
    ]
  },
  "collaborate": {
    "flags": ["--rounds", "1", "--messages", "3"],
    "goal": "Quick plan for a log parser CLI. Keep it brief — discuss approach first, then propose tasks."
  },
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 15},
    {
      "action": "wait_discussion",
      "min_total": 1,
      "timeout": "180s"
    },
    {"action": "assert_messages", "none_match": ["execution phase — task prompts only"]}
  ],
  "cleanup": "cancel"
}
