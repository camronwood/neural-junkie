{
  "name": "document-findings-execution",
  "description": "Task phrased as 'Document findings in collabs/<id>/findings.md' (no Write verb) must dispatch and produce a file deliverable; collab may auto-complete when work finishes, and /complete-collab verifies idempotent close to completed phase.",
  "channel": "collab-scenarios",
  "agents": "@BackendEngineer @SoftwareArchitect",
  "required_agents": [
    "BackendEngineer",
    "SoftwareArchitect"
  ],
  "workspace": {
    "fixture": "findings-scope-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "1",
      "--messages",
      "3"
    ],
    "goal": "@BackendEngineer @BackendEngineer Plan one task using this exact line: - Task 1: @BackendEngineer - Document findings in collabs/<id>/findings.md summarizing README.md and core/sample/main.go."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 30,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "README|main\\.go|core/sample|minimal"
        ],
        "none_match": [
          "index\\.js",
          "utils\\.js",
          "\\[Insert",
          "lorem ipsum"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 20
    },
    {
      "action": "wait_discussion",
      "min_total": 2,
      "min_per_agent": 1,
      "required_agents": [
        "BackendEngineer",
        "SoftwareArchitect"
      ],
      "timeout": "180s",
      "retries": 1,
      "nudge_agents": [
        "BackendEngineer",
        "SoftwareArchitect"
      ],
      "retry_on_generation_error": true
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 1,
      "max_tasks": 2,
      "tasks_have_file_deliverable": true,
      "content_any_match": [
        "findings\\.md"
      ]
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 45
    },
    {
      "action": "workspace_ack"
    },
    {
      "action": "assert_deliverable_stubs",
      "min_stubs": 1,
      "require_plan_md": true,
      "skip_names": [
        "README.md",
        "planning-summary.md",
        "session-summary.md",
        "plan.md"
      ]
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 1,
      "all_match": false,
      "timeout": "300s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "findings.md",
      "target_rel": "collabs/<collab-id>/findings.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "must_exist": true,
      "min_bytes": 30,
      "deny_task_status": true
    },
    {
      "action": "send",
      "content": "/complete-collab <collab-id> --force"
    },
    {
      "action": "wait_phase",
      "phase": "completed",
      "timeout": "120s"
    },
    {
      "action": "assert_collab",
      "phase": "completed"
    }
  ],
  "cleanup": "cancel"
}
