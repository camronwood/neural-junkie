{
  "name": "collab-conversation-quality-regression",
  "description": "Execution deliverables must be substantive prose (no placeholders) and collab discussion must not be raw JSON (26e9081e session regression).",
  "tags": ["collab", "conversation", "regression"],
  "channel": "collab-scenarios",
  "agents": "@ChatModerator @Assistant",
  "required_agents": ["Assistant"],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": ["--workspace", "--rounds", "1", "--messages", "3"],
    "goal": "@ChatModerator @Assistant Plan one task using this exact line: - Task 1: @Assistant - Document findings in collabs/<id>/findings.md summarizing README.md and core/sample/main.go with three concrete bullets."
  },
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 20},
    {"action": "wait_phase", "phase": "reviewing", "timeout": "180s"},
    {"action": "wait_planning_recap", "timeout": "120s"},
    {
      "action": "assert_plan",
      "min_tasks": 1,
      "max_tasks": 2,
      "tasks_have_file_deliverable": true,
      "content_any_match": ["findings\\.md"]
    },
    {"action": "approve_plan"},
    {"action": "wait_phase", "phase": "executing", "timeout": 45},
    {
      "action": "assert_messages",
      "phase": "executing",
      "deny_json_discussion": true,
      "deny_generation_errors": true
    },
    {"action": "send", "content": "/resume-plan <collab-id>"},
    {"action": "wait_tasks", "settle_only": true, "timeout": "120s"},
    {
      "action": "approve_file_changes",
      "path_match": "findings.md",
      "target_rel": "collabs/<collab-id>/findings.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "must_exist": true,
      "min_bytes": 40,
      "any_match": ["README|main\\.go|minimal|sample"],
      "none_match": ["\\[Insert", "insert file name", "lorem ipsum", "TASK_STATUS:"]
    },
    {
      "action": "assert_messages",
      "deny_json_discussion": true,
      "none_match": ["\\[Insert File Name\\]", "insert issues"]
    }
  ],
  "cleanup": "cancel"
}
