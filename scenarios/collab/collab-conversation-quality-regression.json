{
  "name": "collab-conversation-quality-regression",
  "description": "Execution deliverables must be substantive prose (no placeholders) and collab discussion must not be raw JSON (26e9081e session regression).",
  "tags": ["collab", "conversation", "regression"],
  "channel": "collab-scenarios",
  "agents": "@Assistant",
  "required_agents": ["Assistant"],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": ["--workspace", "--rounds", "1", "--messages", "3"],
    "goal": "Use ONLY README.md and core/sample/main.go from the workspace. Do not reference src/theme.css or other paths. Plan one task: - Task 1: @Assistant - Write collabs/<id>/findings.md with three bullets about README.md and core/sample/main.go only."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 40,
      "for_question": {
        "any_match": ["README|main\\.go|minimal|sample"],
        "none_match": ["\\[Insert", "insert file name", "lorem ipsum", "TASK_STATUS:", "index\\.js", "utils\\.js", "\\bapp\\.js\\b"]
      },
      "llm_judge": {
        "criteria": "PASS only if findings cite README.md and/or core/sample/main.go from minimal-repo. FAIL if findings cite src/theme.css, index.js, or other hallucinated paths."
      }
    }
  ],
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 30},
    {
      "action": "wait_discussion",
      "min_total": 2,
      "required_agents": ["Assistant"],
      "timeout": "300s",
      "retries": 2,
      "nudge_agents": ["Assistant"],
      "retry_on_generation_error": true
    },
    {"action": "wait_phase", "phase": "reviewing", "timeout": "180s"},
    {"action": "wait_planning_recap", "timeout": "180s"},
    {
      "action": "assert_plan",
      "min_tasks": 1,
      "max_tasks": 3,
      "tasks_have_file_deliverable": true,
      "content_any_match": ["findings\\.md"]
    },
    {"action": "approve_plan"},
    {"action": "wait_phase", "phase": "executing", "timeout": 45},
    {
      "action": "assert_messages",
      "phase": "executing",
      "deny_json_discussion": true,
      "deny_generation_errors": true,
      "allow_recovered_generation_errors": true
    },
    {"action": "send", "content": "/resume-plan <collab-id>"},
    {"action": "wait_tasks", "min_completed": 1, "all_match": false, "timeout": "300s"},
    {"action": "send", "content": "@Assistant Complete Task 1: write collabs/<collab-id>/findings.md with three bullets citing README.md and core/sample/main.go only."},
    {"action": "wait_tasks", "min_completed": 1, "all_match": false, "timeout": "180s"},
    {
      "action": "approve_file_changes",
      "path_match": "findings.md",
      "target_rel": "collabs/<collab-id>/findings.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "must_exist": true,
      "min_bytes": 40,
      "any_match": ["README|main\\.go|minimal|sample"],
      "none_match": ["\\[Insert", "insert file name", "lorem ipsum", "TASK_STATUS:", "index\\.js", "utils\\.js", "\\bapp\\.js\\b"]
    },
    {
      "action": "assert_messages",
      "deny_json_discussion": true,
      "none_match": ["\\[Insert File Name\\]", "insert issues"]
    }
  ],
  "cleanup": "cancel"
}
