{
  "name": "execute-deliverable",
  "description": "Approve plan, ack workspace on fixture repo; auto-approve writes findings.md grounded in minimal-repo; collab may auto-complete when work finishes, and /complete-collab verifies idempotent close to completed phase.",
  "channel": "collab-scenarios",
  "agents": "@BackendEngineer @SoftwareArchitect",
  "required_agents": [
    "BackendEngineer",
    "SoftwareArchitect"
  ],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "1",
      "--messages",
      "3"
    ],
    "goal": "@BackendEngineer @SoftwareArchitect Plan one task using this exact line: - Task 1: @BackendEngineer - Write collabs/<collab-id>/findings.md summarizing README.md and core/sample/main.go only (three substantive bullets; do not mention src/, React, or server/main.go)."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 40,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "main\\.go",
          "core/sample",
          "minimal"
        ],
        "none_match": [
          "index\\.js",
          "utils\\.js",
          "\\bapp\\.js\\b",
          "App\\.tsx",
          "src/",
          "React",
          "server/main\\.go",
          "data handling module",
          "security vulnerabilities identified"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 20
    },
    {
      "action": "wait_discussion",
      "min_total": 2,
      "min_per_agent": 1,
      "required_agents": [
        "BackendEngineer",
        "SoftwareArchitect"
      ],
      "timeout": "180s",
      "retries": 1,
      "nudge_agents": [
        "BackendEngineer",
        "SoftwareArchitect"
      ],
      "retry_on_generation_error": true
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 45
    },
    {
      "action": "workspace_ack"
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 1,
      "all_match": false,
      "timeout": "300s"
    },
    {
      "action": "assert_messages",
      "phase": "executing",
      "require_task_status": true,
      "deny_task_status_blocked": true,
      "deny_failed_command_output": true,
      "none_match": [
        "index\\.js",
        "utils\\.js",
        "\\bapp\\.js\\b",
        "App\\.tsx",
        "src/",
        "React",
        "server/main\\.go",
        "data handling module"
      ]
    },
    {
      "action": "approve_file_changes",
      "path_match": "findings.md",
      "target_rel": "collabs/<collab-id>/findings.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "must_exist": true,
      "min_bytes": 40,
      "deny_task_status": true,
      "any_match": [
        "main\\.go",
        "core/sample",
        "minimal"
      ],
      "none_match": [
        "index\\.js",
        "utils\\.js",
        "\\bapp\\.js\\b",
        "App\\.tsx",
        "src/",
        "React",
        "server/main\\.go",
        "data handling module",
        "security vulnerabilities identified"
      ]
    },
    {
      "action": "send",
      "content": "/complete-collab <collab-id> --force"
    },
    {
      "action": "wait_phase",
      "phase": "completed",
      "timeout": "120s"
    },
    {
      "action": "assert_collab",
      "phase": "completed"
    }
  ],
  "cleanup": "cancel"
}
