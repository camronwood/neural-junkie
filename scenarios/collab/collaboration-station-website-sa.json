{
  "name": "collaboration-station-website-sa",
  "description": "FrontendEngineer, SoftwareArchitect, and Claude plan markdown specs (site-structure, design-system, layout-specs) for Collaboration Station with prior collab HTML/CSS in workspace.",
  "tags": [
    "collab",
    "execution",
    "regression",
    "website"
  ],
  "channel": "collab-scenarios",
  "agents": "@FrontendEngineer @SoftwareArchitect @Claude",
  "required_agents": [
    "FrontendEngineer",
    "SoftwareArchitect",
    "Claude"
  ],
  "workspace": {
    "fixture": "website-prior-collab",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/frontend_architecture_plan.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/index.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/about.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/contact.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/style.css\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "2",
      "--messages",
      "12"
    ],
    "goal": "@FrontendEngineer @SoftwareArchitect @Claude Design Collaboration Station (colors: black, white, gray, blue, red; pages: home, about, contact). Review collabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/ first. Produce EXACTLY three tasks and no others:\n- Task 1: @SoftwareArchitect - Write collabs/<id>/site-structure.md (navigation and page hierarchy)\n- Task 2: @FrontendEngineer - Write collabs/<id>/design-system.md (color palette, typography, spacing)\n- Task 3: @FrontendEngineer - Write collabs/<id>/layout-specs.md (responsive templates for home, about, contact)"
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/site-structure.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "navigation|page|home|about|contact|structure|Collaboration Station"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/design-system.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "color|typography|spacing|palette|black|white|gray|blue|red"
        ],
        "none_match": [
          "_Initial stub created",
          "index\\.js",
          "utils\\.js"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 45
    },
    {
      "action": "wait_discussion",
      "min_total": 3,
      "min_per_agent": 1,
      "required_agents": [
        "FrontendEngineer",
        "SoftwareArchitect",
        "Claude"
      ],
      "timeout": "360s",
      "retries": 1,
      "nudge_agents": [
        "Claude"
      ]
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "300s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "300s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 3,
      "max_tasks": 5,
      "tasks_have_assignee": true,
      "tasks_have_file_deliverable": true,
      "assignee_min_tasks": {
        "SoftwareArchitect": 1,
        "FrontendEngineer": 1
      },
      "content_any_match": [
        "site-structure\\.md",
        "design-system\\.md",
        "layout-specs\\.md"
      ]
    },
    {
      "action": "assert_messages",
      "any_match": [
        "b222bffe|Collaboration Station"
      ],
      "none_match": [
        "Grounding: I loaded",
        "index\\.js",
        "utils\\.js",
        "write_file"
      ]
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 60
    },
    {
      "action": "assert_collab",
      "phase": "executing",
      "workspace_acknowledged": true,
      "tasks_dispatched": true,
      "source_repo_path_nonempty": true
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 1,
      "all_match": false,
      "timeout": "300s"
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 2,
      "all_match": false,
      "timeout": "540s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "site-structure.md",
      "target_rel": "collabs/<collab-id>/site-structure.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "design-system.md",
      "target_rel": "collabs/<collab-id>/design-system.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/site-structure.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "none_match": [
        "_Initial stub created"
      ]
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/design-system.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "none_match": [
        "_Initial stub created",
        "index\\.js",
        "utils\\.js"
      ]
    }
  ],
  "cleanup": "cancel"
}
