{
  "name": "execution-no-stack-commands",
  "description": "Markdown deliverable execution must not surface docker-compose/npm/kubectl Run suggestions despite decoy stack files in the tree (f7518f88 + stack decoy regression).",
  "channel": "collab-scenarios",
  "agents": "@BackendEngineer @PlatformEngineer",
  "required_agents": [
    "BackendEngineer",
    "PlatformEngineer"
  ],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\ndocker-compose.yml\npackage.json\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "1",
      "--messages",
      "4"
    ],
    "goal": "@BackendEngineer @PlatformEngineer Plan ONE task only: @BackendEngineer Write collabs/<id>/findings.md with three bullets grounded in README.md and core/sample/main.go. Do NOT plan docker, npm, or deployment work — markdown file only."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 40,
      "for_question": {
        "any_match": [
          "main\\.go|README|minimal"
        ],
        "none_match": [
          "docker-compose up",
          "npm install",
          "kubectl"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 25
    },
    {
      "action": "wait_discussion",
      "min_total": 2,
      "min_per_agent": 1,
      "required_agents": [
        "BackendEngineer",
        "PlatformEngineer"
      ],
      "timeout": "180s",
      "retries": 1,
      "nudge_agents": [
        "BackendEngineer",
        "PlatformEngineer"
      ],
      "retry_on_generation_error": true
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 1,
      "max_tasks": 2,
      "tasks_have_file_deliverable": true,
      "task_none_match": [
        "docker-compose",
        "npm install",
        "kubectl"
      ]
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 45
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "settle_only": true,
      "timeout": "120s"
    },
    {
      "action": "assert_messages",
      "phase": "executing",
      "none_match": [
        "docker-compose up",
        "docker compose up",
        "npm install",
        "npm run",
        "kubectl get",
        "helm install"
      ],
      "deny_suggested_stack_commands": true,
      "deny_failed_command_output": true
    },
    {
      "action": "approve_file_changes",
      "path_contains": "findings.md",
      "target_rel": "collabs/<collab-id>/findings.md",
      "from_discussion_fallback": true,
      "min_approved": 0,
      "timeout": 90
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/findings.md",
      "min_bytes": 40,
      "any_match": [
        "main\\.go|README|minimal"
      ],
      "none_match": [
        "docker-compose up",
        "npm install"
      ]
    }
  ],
  "cleanup": "cancel"
}
