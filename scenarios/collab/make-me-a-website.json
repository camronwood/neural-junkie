{
  "name": "make-me-a-website",
  "description": "Natural-language 'make me a website' must plan and execute real HTML/CSS pages, not markdown specs only.",
  "tags": [
    "collab",
    "execution",
    "regression",
    "website"
  ],
  "channel": "collab-scenarios",
  "agents": "@FrontendEngineer @Claude",
  "required_agents": [
    "FrontendEngineer",
    "Claude"
  ],
  "workspace": {
    "fixture": "website-prior-collab",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/index.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/style.css\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "2",
      "--messages",
      "12"
    ],
    "goal": "@FrontendEngineer @Claude Make Collaboration Station (colors: black, white, gray, blue, red). Produce EXACTLY four tasks and no others, using these exact lines:\n- Task 1: @FrontendEngineer - Write collabs/<id>/style.css with the color palette\n- Task 2: @FrontendEngineer - Write collabs/<id>/index.html home page linking about/contact\n- Task 3: @Claude - Write collabs/<id>/about.html using style.css\n- Task 4: @Claude - Write collabs/<id>/contact.html using style.css\nReal HTML/CSS only — no markdown specs."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/index.html",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "<!DOCTYPE|<html|Collaboration Station"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/about.html",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "<!DOCTYPE|<html|about|Collaboration Station"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/contact.html",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "<!DOCTYPE|<html|contact|Collaboration Station"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/style.css",
      "min_bytes": 40,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "color|background|font|#|rgb|Collaboration"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 45
    },
    {
      "action": "wait_discussion",
      "min_total": 2,
      "min_per_agent": 1,
      "required_agents": [
        "FrontendEngineer",
        "Claude"
      ],
      "timeout": "360s",
      "retries": 1,
      "nudge_agents": [
        "Claude"
      ]
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "300s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "300s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 4,
      "max_tasks": 5,
      "tasks_have_assignee": true,
      "tasks_have_file_deliverable": true,
      "content_any_match": [
        "index\\.html",
        "about\\.html",
        "contact\\.html",
        "style\\.css"
      ],
      "content_none_match": [
        "specs only|planning docs only|before implementing pages"
      ]
    },
    {
      "action": "assert_messages",
      "none_match": [
        "Grounding: I loaded",
        "index\\.js",
        "utils\\.js"
      ]
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 60
    },
    {
      "action": "assert_collab",
      "phase": "executing",
      "workspace_acknowledged": true,
      "tasks_dispatched": true
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 2,
      "all_match": false,
      "timeout": "360s"
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 4,
      "all_match": true,
      "timeout": "540s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "index.html",
      "target_rel": "collabs/<collab-id>/index.html",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "about.html",
      "target_rel": "collabs/<collab-id>/about.html",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "contact.html",
      "target_rel": "collabs/<collab-id>/contact.html",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "approve_file_changes",
      "path_match": ".css",
      "target_rel": "collabs/<collab-id>/style.css",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/index.html",
      "path_alternatives": [
        "collabs/<collab-id>/homepage.html",
        "collabs/<collab-id>/home.html"
      ]
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/about.html"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/contact.html"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/style.css"
    }
  ],
  "cleanup": "cancel"
}
