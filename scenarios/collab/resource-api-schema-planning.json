{
  "name": "resource-api-schema-planning",
  "description": "Phoenix-style prompt with SoftwareArchitect and PlatformEngineer plus @Claude for planning synthesis.",
  "channel": "collab-scenarios",
  "agents": "@SoftwareArchitect @PlatformEngineer @Claude",
  "required_agents": [
    "SoftwareArchitect",
    "PlatformEngineer",
    "Claude"
  ],
  "workspace": {
    "path_env": "NEURAL_JUNKIE_SCENARIO_REPO",
    "workspace_flag": true,
    "outline": true
  },
  "collaborate": {
    "flags": [
      "--rounds",
      "2",
      "--messages",
      "5"
    ],
    "goal": "@SoftwareArchitect @PlatformEngineer @Claude Investigate resource api document schema standardization/registration, and produce a markdown document. Lanes: @Claude synthesizes plan; @SoftwareArchitect drafts schema/doc standards and markdown from the approved outline; @PlatformEngineer covers CI/release of docs, not schema design."
  },
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 30
    },
    {
      "action": "wait_discussion",
      "min_total": 3,
      "min_per_agent": 1,
      "required_agents": [
        "SoftwareArchitect",
        "PlatformEngineer",
        "Claude"
      ],
      "timeout": "240s"
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "assert_messages",
      "none_match": [
        "Grounding: I loaded",
        "index\\.js",
        "utils\\.js",
        "check_pod_logs",
        "kubectl",
        "\"namespace\"\\s*:",
        "\"name\"\\s*:\\s*\"kubectl"
      ],
      "any_match": [
        "schema|standardiz|registr|markdown|resource\\s*api"
      ]
    },
    {
      "action": "assert_plan",
      "min_tasks": 2,
      "max_tasks": 6,
      "tasks_have_assignee": true,
      "title_none_match": [
        "task is to ",
        "should perform ",
        "review will "
      ],
      "content_any_match": [
        "schema|standardiz|registr|markdown|resource\\s*api"
      ],
      "content_none_match": [
        "index\\.js",
        "utils\\.js"
      ]
    },
    {
      "action": "assert_collab",
      "phase": "reviewing"
    }
  ],
  "cleanup": "cancel"
}
