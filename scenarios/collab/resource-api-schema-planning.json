{
  "name": "resource-api-schema-planning",
  "description": "SoftwareArchitect and PlatformEngineer plus @Claude for resource-api schema planning synthesis.",
  "channel": "collab-scenarios",
  "agents": "@SoftwareArchitect @PlatformEngineer @Claude",
  "required_agents": [
    "SoftwareArchitect",
    "PlatformEngineer",
    "Claude"
  ],
  "workspace": {
    "path_env": "NEURAL_JUNKIE_SCENARIO_REPO",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "resource-api/json_endpoints/\ndocs/tim/\nREADME.md\n"
  },
  "collaborate": {
    "flags": [
      "--rounds",
      "2",
      "--messages",
      "5"
    ],
    "goal": "@SoftwareArchitect @PlatformEngineer @Claude Investigate resource api document schema standardization/registration. Produce EXACTLY two tasks and no others, using these exact lines:\n- Task 1: @SoftwareArchitect - Write collabs/<id>/schema-standards.md covering schema/doc standards from resource-api/json_endpoints and docs/tim\n- Task 2: @PlatformEngineer - Write collabs/<id>/ci-release-docs.md covering CI/release of docs (not schema design). @Claude synthesizes the plan only."
  },
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 30
    },
    {
      "action": "wait_discussion",
      "min_total": 3,
      "min_per_agent": 1,
      "required_agents": [
        "SoftwareArchitect",
        "PlatformEngineer",
        "Claude"
      ],
      "timeout": "240s",
      "retries": 1,
      "nudge_agents": [
        "Claude",
        "SoftwareArchitect"
      ],
      "nudge_silent_agents": true
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "180s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "120s"
    },
    {
      "action": "assert_messages",
      "none_match": [
        "Grounding: I loaded",
        "index\\.js",
        "utils\\.js",
        "check_pod_logs",
        "kubectl",
        "\"namespace\"\\s*:",
        "\"name\"\\s*:\\s*\"kubectl"
      ],
      "any_match": [
        "schema|standardiz|registr|markdown|resource\\s*api"
      ]
    },
    {
      "action": "assert_plan",
      "min_tasks": 2,
      "max_tasks": 6,
      "tasks_have_assignee": true,
      "title_none_match": [
        "task is to ",
        "should perform ",
        "review will "
      ],
      "content_any_match": [
        "schema|standardiz|registr|markdown|resource\\s*api"
      ],
      "content_none_match": [
        "index\\.js",
        "utils\\.js"
      ]
    },
    {
      "action": "assert_collab",
      "phase": "reviewing"
    }
  ],
  "cleanup": "cancel"
}
