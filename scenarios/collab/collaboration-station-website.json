{
  "name": "collaboration-station-website",
  "description": "FrontendEngineer, SecurityReviewer, and Claude plan and execute a three-page website collab with prior HTML/CSS under collabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/.",
  "tags": [
    "collab",
    "execution",
    "regression",
    "website"
  ],
  "channel": "collab-scenarios",
  "agents": "@FrontendEngineer @SecurityReviewer @Claude",
  "required_agents": [
    "FrontendEngineer",
    "SecurityReviewer",
    "Claude"
  ],
  "workspace": {
    "fixture": "website-prior-collab",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/frontend_architecture_plan.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/index.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/about.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/contact.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/style.css\n"
  },
  "collaborate": {
    "flags": [
      "--workspace",
      "--rounds",
      "2",
      "--messages",
      "12"
    ],
    "goal": "@FrontendEngineer @SecurityReviewer @Claude Design Collaboration Station (colors: black, white, gray, blue, red; pages: home, about, contact). Review collabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/ first. Produce EXACTLY three tasks and no others, using these exact lines:\n- Task 1: @FrontendEngineer - Write collabs/<id>/architecture-review.md comparing b222bffe frontend_architecture_plan.md to the color spec\n- Task 2: @SecurityReviewer - Write collabs/<id>/security-audit.md reviewing b222bffe HTML/CSS for XSS and contact-form handling\n- Task 3: @Claude - Write collabs/<id>/homepage.html, aboutpage.html, contactpage.html using Tasks 1-2 (depends on Tasks 1-2)"
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/architecture-review.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "architecture|color|b222bffe|frontend_architecture|Collaboration Station|palette|review|plan"
        ],
        "none_match": [
          "_Initial stub created"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/security-audit.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": [
          "security|XSS|contact|HTML|CSS|audit"
        ],
        "none_match": [
          "_Initial stub created",
          "index\\.js",
          "utils\\.js"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "wait_phase",
      "phase": "planning",
      "timeout": 45
    },
    {
      "action": "wait_discussion",
      "min_total": 3,
      "min_per_agent": 1,
      "required_agents": [
        "FrontendEngineer",
        "SecurityReviewer",
        "Claude"
      ],
      "timeout": "300s",
      "retries": 1,
      "nudge_agents": [
        "FrontendEngineer",
        "SecurityReviewer",
        "Claude"
      ]
    },
    {
      "action": "wait_phase",
      "phase": "reviewing",
      "timeout": "240s"
    },
    {
      "action": "wait_planning_recap",
      "timeout": "300s"
    },
    {
      "action": "assert_plan",
      "min_tasks": 3,
      "max_tasks": 4,
      "tasks_have_assignee": true,
      "tasks_have_file_deliverable": true,
      "assignee_min_tasks": {
        "FrontendEngineer": 1,
        "SecurityReviewer": 1,
        "Claude": 1
      },
      "content_any_match": [
        "architecture-review\\.md",
        "security-audit",
        "homepage|aboutpage|contactpage|\\.html"
      ]
    },
    {
      "action": "assert_messages",
      "any_match": [
        "b222bffe"
      ],
      "none_match": [
        "Grounding: I loaded",
        "index\\.js",
        "utils\\.js"
      ]
    },
    {
      "action": "approve_plan"
    },
    {
      "action": "wait_phase",
      "phase": "executing",
      "timeout": 60
    },
    {
      "action": "assert_collab",
      "phase": "executing",
      "workspace_acknowledged": true,
      "tasks_dispatched": true,
      "source_repo_path_nonempty": true
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 1,
      "all_match": false,
      "timeout": "360s"
    },
    {
      "action": "send",
      "content": "/resume-plan <collab-id>"
    },
    {
      "action": "wait_tasks",
      "min_completed": 2,
      "all_match": false,
      "timeout": "600s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "architecture-review.md",
      "target_rel": "collabs/<collab-id>/architecture-review.md",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "approve_file_changes",
      "path_match": "security-audit.md",
      "target_rel": "collabs/<collab-id>/security-audit.md",
      "from_discussion_fallback": false,
      "min_approved": 0,
      "timeout": "120s"
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/architecture-review.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "none_match": [
        "_Initial stub created"
      ]
    },
    {
      "action": "assert_files",
      "path": "collabs/<collab-id>/security-audit.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "none_match": [
        "_Initial stub created",
        "index\\.js",
        "utils\\.js"
      ]
    }
  ],
  "cleanup": "cancel"
}
