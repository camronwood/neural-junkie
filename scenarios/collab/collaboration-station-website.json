    },
    {
      "action": "assert_messages",
      "any_match": ["b222bffe"],
      "none_match": ["Grounding: I loaded", "index\\.js", "utils\\.js"]
    },
    {"action": "approve_plan"},
    {"action": "wait_phase", "phase": "executing", "timeout": 60},
    {
      "action": "assert_collab",
      "phase": "executing",
