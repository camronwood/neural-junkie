  "collaborate": {
    "flags": ["--workspace", "--rounds", "3", "--messages", "18"],
    "goal": "@FrontendEngineer @SecurityReviewer @Gemini Design a website named Collaboration Station. Colors: black, white, gray, blue, red. Three pages: home, about, contact. Review existing work under collabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/ (frontend_architecture_plan.md, HTML, CSS) before planning. End with exactly three file tasks under collabs/<id>/: Task 1 @FrontendEngineer Write architecture-review.md comparing b222bffe frontend_architecture_plan.md to the new color spec; Task 2 @SecurityReviewer Write security-audit.md reviewing b222bffe HTML/CSS for XSS and contact-form handling; Task 3 @Gemini Write homepage.html, aboutpage.html, contactpage.html using reviews from Tasks 1-2 (Task 3 depends on Tasks 1-2)."
  },
  "expect_deliverables": [
    {
      "path": "collabs/<collab-id>/architecture-review.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": ["architecture|color|b222bffe|frontend_architecture|Collaboration Station"],
        "none_match": ["_Initial stub created"]
      },
      "llm_judge": true
    },
    {
      "path": "collabs/<collab-id>/security-audit.md",
      "min_bytes": 80,
      "deny_task_status": true,
      "for_question": {
        "any_match": ["security|XSS|contact|HTML|CSS|audit"],
        "none_match": ["_Initial stub created", "index\\.js", "utils\\.js"]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 45},
    {
      "action": "wait_discussion",
      "min_total": 3,
      "min_per_agent": 1,
      "required_agents": ["FrontendEngineer", "SecurityReviewer", "Gemini"],
      "timeout": "300s",
      "retries": 1,
      "nudge_agents": ["SecurityReviewer"]
    },
    {"action": "wait_phase", "phase": "reviewing", "timeout": "240s"},
    {"action": "wait_planning_recap", "timeout": "300s"},
    {
      "action": "assert_plan",
