    "outline": true,
    "file_tree": "README.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/frontend_architecture_plan.md\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/index.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/about.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/contact.html\ncollabs/b222bffe-39e8-4b00-91ca-ee1c555b9592/style.css\n"
