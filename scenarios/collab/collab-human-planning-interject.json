{
  "name": "collab-human-planning-interject",
  "description": "Human steers planning mid-discussion; agents still reach reviewing with substantive prose (no raw JSON).",
  "tags": ["collab", "conversation", "regression", "participation"],
  "channel": "collab-scenarios",
  "agents": "@SoftwareArchitect @BackendEngineer",
  "required_agents": ["SoftwareArchitect", "BackendEngineer"],
  "workspace": {
    "fixture": "minimal-repo",
    "workspace_flag": true,
    "outline": true,
    "file_tree": "README.md\ncore/sample/main.go\n"
  },
  "collaborate": {
    "flags": ["--workspace", "--rounds", "2", "--messages", "4"],
    "goal": "@SoftwareArchitect @BackendEngineer Plan tasks to document this repo. Use exactly: - Task 1: @SoftwareArchitect - Write collabs/<id>/readme-summary.md from README.md. - Task 2: @BackendEngineer - Write collabs/<id>/main-summary.md from core/sample/main.go."
  },
  "steps": [
    {"action": "wait_phase", "phase": "planning", "timeout": 20},
    {
      "action": "send",
      "content": "Please focus only on README.md and core/sample/main.go — keep the plan brief."
    },
    {
      "action": "wait_discussion",
      "min_total": 2,
      "min_per_agent": 1,
      "required_agents": ["SoftwareArchitect", "BackendEngineer"],
      "nudge_agents": ["BackendEngineer"],
      "timeout": "180s"
    },
    {"action": "wait_phase", "phase": "reviewing", "timeout": "180s"},
    {"action": "wait_planning_recap", "timeout": "120s"},
    {
      "action": "assert_plan",
      "min_tasks": 2
    },
    {
      "action": "assert_messages",
      "deny_json_discussion": true,
      "any_match": ["README|main\\.go|minimal|sample"],
      "none_match": ["Grounding: I loaded", "\\[Insert"]
    },
    {"action": "assert_collab", "phase": "reviewing"}
  ],
  "cleanup": "cancel"
}
