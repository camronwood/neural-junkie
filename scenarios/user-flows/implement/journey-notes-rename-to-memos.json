{
  "name": "journey-notes-rename-to-memos",
  "description": "Multi-turn goal: implement notes API → mid-session rename resource to memos → scrub /notes → finish.",
  "tags": [
    "user-flow",
    "journey",
    "long-horizon",
    "correction",
    "nodejs",
    "implement"
  ],
  "evaluation": {
    "long_horizon": true,
    "min_user_turns": 4
  },
  "channel": "user-flow-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "user-flow-empty"
  },
  "expect_deliverables": [
    {
      "path": "package.json",
      "min_bytes": 40,
      "for_question": {
        "any_match": [
          "\"name\"|typescript|express|fastify|hono"
        ],
        "none_match": [
          "lorem ipsum"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "src/server.ts",
      "path_alternatives": [
        "src/index.ts",
        "src/app.ts",
        "server.ts"
      ],
      "min_bytes": 120,
      "for_question": {
        "contains_all": [
          "/memos"
        ],
        "any_match": [
          "memo|Memo",
          "get|post|put|delete|router|app\\.(get|post|put|delete)|listen"
        ],
        "none_match": [
          "/notes",
          "lorem ipsum",
          "\\[Insert"
        ]
      },
      "llm_judge": {
        "criteria": "PASS when the API resource is memos (routes/types/handlers) and /notes routes are gone. FAIL if notes routes remain as the primary resource after the rename correction."
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "Build a local notes CRUD API with Node.js + TypeScript. Use an in-memory store, package.json, and src/server.ts (or src/index.ts). Expose create/read/update/delete for notes.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "720s",
      "until_file_match": {
        "path": "package.json",
        "any_match": [
          "\"name\"|typescript|express|fastify|hono"
        ]
      },
      "until_files_exist": [
        "package.json"
      ],
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "send",
      "content": "Correction: rename the resource from notes to memos everywhere — routes, types, and handlers. Prefer /memos.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "540s",
      "until_file_match": {
        "path": "src/server.ts",
        "path_alternatives": [
          "src/index.ts",
          "src/app.ts",
          "server.ts"
        ],
        "any_match": [
          "memo|Memo|/memos"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "send",
      "content": "Do not leave /notes routes — only /memos should remain as the resource path.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_file_match": {
        "path": "src/server.ts",
        "path_alternatives": [
          "src/index.ts",
          "src/app.ts",
          "server.ts"
        ],
        "contains_all": [
          "/memos"
        ],
        "none_match": [
          "/notes"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "send",
      "content": "Confirm memos CRUD is the only resource and stop. No extra endpoints.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_file_match": {
        "path": "src/server.ts",
        "path_alternatives": [
          "src/index.ts",
          "src/app.ts",
          "server.ts"
        ],
        "contains_all": [
          "/memos"
        ],
        "none_match": [
          "/notes"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "package.json"
    },
    {
      "action": "assert_file_exists",
      "path": "src/server.ts",
      "path_alternatives": [
        "src/index.ts",
        "src/app.ts",
        "server.ts"
      ],
      "contains_all": [
        "/memos"
      ],
      "none_match": [
        "/notes"
      ]
    }
  ],
  "cleanup": "clear"
}
