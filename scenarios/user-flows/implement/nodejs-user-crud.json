{
  "name": "nodejs-user-crud",
  "description": "Real user flow: Node.js + TypeScript CRUD API for user management with a simple server and seed users.",
  "tags": [
    "user-flow",
    "nodejs",
    "typescript",
    "api",
    "implement"
  ],
  "channel": "user-flow-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "user-flow-empty"
  },
  "expect_deliverables": [
    {
      "path": "package.json",
      "min_bytes": 40,
      "for_question": {
        "any_match": [
          "\"name\"|typescript|express|fastify|hono"
        ],
        "none_match": [
          "lorem ipsum"
        ]
      },
      "llm_judge": true
    },
    {
      "path": "src/server.ts",
      "path_alternatives": [
        "src/index.ts",
        "src/app.ts",
        "server.ts"
      ],
      "min_bytes": 120,
      "for_question": {
        "any_match": [
          "user|User",
          "get|post|put|delete|router|app\\.(get|post|put|delete)|listen"
        ],
        "none_match": [
          "lorem ipsum",
          "\\[Insert"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "Let's design and implement a CRUD API for user management. Use Node.js with TypeScript. Set up a simple server under src/server.ts (or src/index.ts) plus package.json, and seed a few test users. Keep everything local (in-memory store is fine). Expose create/read/update/delete for users.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "720s",
      "until_files_exist": [
        "package.json"
      ],
      "until_file_match": {
        "path": "src/server.ts",
        "path_alternatives": [
          "src/index.ts",
          "src/app.ts",
          "server.ts"
        ],
        "any_match": [
          "user|User",
          "get|post|put|delete|router|app\\.(get|post|put|delete)|listen"
        ],
        "none_match": [
          "lorem ipsum",
          "\\[Insert"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "package.json"
    },
    {
      "action": "assert_file_exists",
      "path": "src/server.ts",
      "path_alternatives": [
        "src/index.ts",
        "src/app.ts",
        "server.ts"
      ]
    }
  ],
  "cleanup": "clear"
}
