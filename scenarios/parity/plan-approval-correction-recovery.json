{
  "name": "plan-approval-correction-recovery",
  "description": "Exercise plan, approval, implementation correction, and interrupted-task continuation across four user turns.",
  "tags": ["parity", "long-horizon", "plan-approval", "correction"],
  "evaluation": {"long_horizon": true, "min_user_turns": 4},
  "channel": "parity-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": ["BackendEngineer"],
  "workspace": {"fixture": "go-verify-repair"},
  "expect_deliverables": [
    {
      "path": "core/sample/math.go",
      "for_question": {
        "any_match": ["func Multiply", "\\*"],
        "none_match": ["return a \\+ b[^*]"]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "Plan the smallest fix for the failing Multiply test in core/sample/math.go. Do not edit files yet.",
      "metadata": {"editor_mode": "plan", "conversation_mode": "code", "context_scope": "workspace"}
    },
    {"action": "wait_reply", "from": "BackendEngineer", "timeout": "300s"},
    {
      "action": "send",
      "content": "I approve the plan. Implement it and verify the test.",
      "metadata": {
        "editor_mode": "agent",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": ["func Multiply", "\\*"],
        "none_match": ["return a \\+ b[^*]"]
      },
      "until_metadata_keys": ["implementation_session_outcome"]
    },
    {
      "action": "send",
      "content": "Correction: preserve the existing Multiply signature and do not edit math_test.go.",
      "metadata": {
        "editor_mode": "agent",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": ["func Multiply", "\\*"],
        "none_match": ["return a \\+ b[^*]"]
      },
      "until_metadata_keys": ["implementation_session_outcome"]
    },
    {
      "action": "send",
      "content": "Resume the approved task from where you stopped and report the go test evidence.",
      "metadata": {
        "editor_mode": "agent",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": ["func Multiply", "\\*"],
        "none_match": ["return a \\+ b[^*]"]
      },
      "until_metadata_keys": ["implementation_session_outcome"]
    },
    {"action": "assert_shell", "command": "go test ./...", "expect_exit": 0}
  ],
  "cleanup": "clear"
}
