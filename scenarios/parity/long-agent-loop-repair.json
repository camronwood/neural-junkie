{
  "name": "long-agent-loop-repair",
  "description": "Agent runtime fixes failing go test without manual go-ahead",
  "tags": [
    "parity",
    "agent-runtime"
  ],
  "channel": "parity-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "go-verify-repair"
  },
  "expect_deliverables": [
    {
      "path": "core/sample/math.go",
      "for_question": {
        "any_match": [
          "func Multiply",
          "\\*"
        ],
        "none_match": [
          "return a \\+ b[^*]"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "please implement: fix the failing tests in core/sample — Multiply is wrong (returns a+b). Make go test ./... pass.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "900s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": [
          "func Multiply",
          "\\*"
        ],
        "none_match": [
          "return a \\+ b[^*]"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_shell",
      "command": "go test ./...",
      "expect_exit": 0
    }
  ],
  "cleanup": "clear"
}
