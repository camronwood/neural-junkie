{
  "name": "multi-file-refactor-10",
  "description": "Agent runtime renames noise util prefix across 10+ files",
  "tags": [
    "parity",
    "agent-runtime",
    "slow"
  ],
  "channel": "parity-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "large-repo"
  },
  "expect_deliverables": [
    {
      "path": "noise/pkg0000/util.go",
      "min_bytes": 20,
      "for_question": {
        "any_match": [
          "UtilRenamed0",
          "func UtilRenamed"
        ],
        "none_match": [
          "func Util0\\("
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "please implement: in noise/pkg0000 through noise/pkg0009 rename each UtilN function to UtilRenamedN in util.go (10 files). Use propose_file_edit for every file.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "900s",
      "until_file_match": {
        "path": "noise/pkg0000/util.go",
        "any_match": [
          "UtilRenamed0",
          "func UtilRenamed"
        ],
        "none_match": [
          "func Util0\\("
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "noise/pkg0000/util.go",
      "contains": "UtilRenamed0"
    },
    {
      "action": "assert_file_exists",
      "path": "noise/pkg0009/util.go",
      "contains": "UtilRenamed9"
    }
  ],
  "cleanup": "clear"
}
