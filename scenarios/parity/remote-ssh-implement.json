{
  "name": "remote-ssh-implement",
  "description": "Local agent applies edit via WorkspaceBackend (simulated remote root)",
  "tags": [
    "parity",
    "remote"
  ],
  "channel": "parity-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "minimal-repo"
  },
  "expect_deliverables": [
    {
      "path": "core/sample/main.go",
      "for_question": {
        "contains_all": ["RemoteParityMarker"],
        "any_match": ["func RemoteParityMarker", "RemoteParityMarker\\("]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "please implement a RemoteParityMarker function in core/sample/main.go and call it from main",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "agent_runtime_v2": true,
        "workspace_backend": "local"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "core/sample/main.go",
        "contains_all": ["RemoteParityMarker"]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "core/sample/main.go",
      "contains": "RemoteParityMarker"
    }
  ],
  "cleanup": "clear"
}
