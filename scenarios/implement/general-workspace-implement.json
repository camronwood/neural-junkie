{
  "name": "general-workspace-implement",
  "description": "Team-channel style: workspace_context + implementation_session metadata (no IDE layout UI).",
  "tags": [
    "implement",
    "frontend",
    "workspace"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "workspace": {
    "fixture": "react-tailwind-minimal"
  },
  "expect_deliverables": [
    {
      "path": "tailwind.config.js",
      "for_question": {
        "contains_all": [
          "darkMode"
        ],
        "none_match": [
          "\\.vue",
          "App\\.vue",
          "ThemeToggle\\.vue",
          "src-tauri/tailwind"
        ]
      },
      "llm_judge": {
        "criteria": "This file is only the Tailwind config. PASS if class-based dark mode is enabled (darkMode). UI toggle logic is validated in App.tsx."
      }
    },
    {
      "path": "src/App.tsx",
      "for_question": {
        "any_match": [
          "toggleTheme|setTheme|useState|dark|light|theme"
        ],
        "none_match": [
          "\\.vue",
          "ThemeToggle\\.vue"
        ]
      },
      "llm_judge": {
        "criteria": "PASS if the sidebar includes a theme toggle control with state/logic for light and dark modes."
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "implement light/dark theme toggle in the sidebar for this project",
      "metadata": {
        "editor_mode": "agent",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code",
        "ide_route_agent_type": "frontend"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "900s",
      "until_file_match": {
        "path": "tailwind.config.js",
        "none_match": [
          "\\.vue",
          "App\\.vue",
          "ThemeToggle\\.vue",
          "src-tauri/tailwind"
        ],
        "contains_all": [
          "darkMode"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes",
        "\\.vue",
        "App\\.vue",
        "ThemeToggle\\.vue",
        "src-tauri/tailwind"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "tailwind.config.js",
      "contains": "darkMode"
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "any_match": [
        "toggleTheme",
        "setTheme",
        "useState",
        "onClick"
      ]
    },
    {
      "action": "assert_message_metadata",
      "from": "FrontendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear"
}
