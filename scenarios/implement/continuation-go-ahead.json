{
  "name": "continuation-go-ahead",
  "description": "User affirms prior implementation ask; session should still run.",
  "tags": [
    "implement",
    "continuation"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "minimal-repo"
  },
  "expect_deliverables": [
    {
      "path": "core/sample/main.go",
      "for_question": {
        "contains_all": [
          "PrintVersion"
        ],
        "any_match": [
          "func PrintVersion",
          "PrintVersion\\("
        ],
        "none_match": [
          "index\\.js"
        ]
      },
      "llm_judge": true
    }
  ],
  "setup": [
    {
      "action": "send",
      "content": "implement a PrintVersion helper in core/sample/main.go",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "go ahead",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_file_match": {
        "path": "core/sample/main.go",
        "any_match": [
          "func PrintVersion",
          "PrintVersion\\("
        ],
        "none_match": [
          "index\\.js"
        ],
        "contains_all": [
          "PrintVersion"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "core/sample/main.go",
      "contains": "PrintVersion"
    },
    {
      "action": "assert_message_metadata",
      "from": "BackendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear"
}
