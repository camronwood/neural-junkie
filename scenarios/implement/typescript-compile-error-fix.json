{
  "name": "typescript-compile-error-fix",
  "description": "Fix TypeScript compile error in src/App.tsx.",
  "tags": [
    "implement",
    "cursor-parity",
    "react",
    "typescript"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "workspace": {
    "fixture": "react-ts-type-error",
    "open_files": [
      "src/App.tsx"
    ],
    "active_file": "src/App.tsx"
  },
  "setup": [
    {
      "action": "assert_shell",
      "command": "npm install --no-audit --no-fund --prefer-offline",
      "timeout_s": 180
    }
  ],
  "expect_deliverables": [
    {
      "path": "src/App.tsx",
      "min_bytes": 40,
      "for_question": {
        "any_match": [
          "export default function App",
          "brokenCount|count"
        ],
        "none_match": [
          "not-a-number",
          "Type 'string' is not assignable"
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "TypeScript is failing to compile src/App.tsx in this workspace. Fix the type error so the app builds.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "420s",
      "until_file_match": {
        "path": "src/App.tsx",
        "any_match": [
          "export default function App",
          "brokenCount|count"
        ],
        "none_match": [
          "not-a-number",
          "Type 'string' is not assignable"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes",
        "not-a-number"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "none_match": [
        "not-a-number"
      ]
    },
    {
      "action": "assert_shell",
      "command": "npm run typecheck",
      "timeout_s": 120
    },
    {
      "action": "assert_message_metadata",
      "from": "FrontendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear"
}
