{
  "name": "typescript-compile-error-fix",
  "description": "Fix TypeScript compile error in src/App.tsx.",
  "tags": ["implement", "cursor-parity", "react", "typescript"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": { "fixture": "react-ts-type-error" },
  "expect_deliverables": [
    {
      "path": "src/App.tsx",
      "min_bytes": 40,
      "for_question": {
        "any_match": ["export default function App", "brokenCount|count"],
        "none_match": ["not-a-number", "Type 'string' is not assignable"]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "TypeScript is failing to compile src/App.tsx in this workspace. Fix the type error so the app builds.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "420s",
      "until_any_match": ["applied and verified|implementation session complete|App.tsx"]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "any_match": ["applied and verified|implementation session complete"],
      "none_match": ["finished without file changes", "not-a-number"]
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "none_match": ["not-a-number"]
    }
  ],
  "cleanup": "clear"
}
