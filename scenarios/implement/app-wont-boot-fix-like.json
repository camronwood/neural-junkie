{
  "name": "app-wont-boot-fix-like",
  "description": "Fix-like flow: vague boot failure triggers repro-first bootstrap and Makefile repair.",
  "tags": ["implement", "fix-like", "boot-fix", "tauri"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": { "fixture": "react-tauri-missing-start-all" },
  "expect_deliverables": [
    {
      "path": "Makefile",
      "for_question": {
        "any_match": ["start-all:", "scripts/start-all.sh"]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "the app won't boot — make start-all fails:\n\n```\n$ make start-all\nmake: *** No rule to make target 'start-all'.  Stop.\n```",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "900s",
      "until_any_match": ["fix session complete|implementation session complete|repro|start-all|Makefile"]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "any_match": ["session complete|start-all|Makefile|repro"],
      "none_match": ["finished without file changes"]
    }
  ],
  "cleanup": "clear"
}
