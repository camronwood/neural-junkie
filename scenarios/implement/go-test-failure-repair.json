{
  "name": "go-test-failure-repair",
  "description": "Fix failing Go unit test in core/sample/math.go (verify loop). Optional soak twin \u2014 excluded from default implement --all.",
  "tags": [
    "implement",
    "cursor-parity",
    "go",
    "verify",
    "soak",
    "optional"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "go-api-with-tests"
  },
  "expect_deliverables": [
    {
      "path": "core/sample/math.go",
      "min_bytes": 20,
      "for_question": {
        "any_match": [
          "func Add",
          "return a \\+ b"
        ],
        "none_match": [
          "a \\+ b \\+ 1",
          "index\\.js"
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "go test ./... fails in core/sample/math_test.go because Add in @file:core/sample/math.go returns the wrong value. Fix math.go so all tests pass.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "900s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": [
          "func Add",
          "return a \\+ b"
        ],
        "none_match": [
          "a \\+ b \\+ 1",
          "index\\.js"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "core/sample/math.go",
      "none_match": [
        "a \\+ b \\+ 1"
      ]
    },
    {
      "action": "assert_message_metadata",
      "from": "BackendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear",
  "optional": true
}
