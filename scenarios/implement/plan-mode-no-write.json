{
  "name": "plan-mode-no-write",
  "description": "Plan composer mode produces structured plan without file edits.",
  "tags": [
    "implement",
    "cursor-parity",
    "plan"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "minimal-repo"
  },
  "expect_no_deliverables": true,
  "steps": [
    {
      "action": "send",
      "content": "Plan how to add a HelloWorld function to core/sample/main.go in this minimal Go repo. Outline steps only.",
      "metadata": {
        "editor_mode": "plan",
        "composer_mode": "plan",
        "ide_route_agent_type": "backend",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "300s"
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "\\[FILE_CHANGE\\]",
        "Proposing to edit",
        "Proposing to create"
      ]
    },
    {
      "action": "assert_no_file_change"
    },
    {
      "action": "assert_message_metadata",
      "from": "BackendEngineer",
      "optional": true,
      "match": {
        "implementation_session_outcome.outcome": "no_changes|session_not_run|blocked|skipped"
      }
    }
  ],
  "cleanup": "clear"
}
