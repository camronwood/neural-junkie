{
  "name": "react-theme-multi-file",
  "description": "Single prompt lands tailwind darkMode and App.tsx theme wiring without a go-ahead turn. Optional soak twin \u2014 excluded from default implement --all.",
  "tags": [
    "implement",
    "frontend",
    "multi-file",
    "soak",
    "optional"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "workspace": {
    "fixture": "react-tailwind-minimal"
  },
  "expect_deliverables": [
    {
      "path": "tailwind.config.js",
      "for_question": {
        "contains_all": [
          "darkMode"
        ],
        "none_match": [
          "\\.vue",
          "ThemeToggle\\.vue"
        ]
      }
    },
    {
      "path": "src/App.tsx",
      "for_question": {
        "any_match": [
          "toggleTheme|setTheme|useState.*theme|dark|light"
        ],
        "none_match": [
          "\\.vue",
          "ThemeToggle\\.vue"
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "implement light/dark theme toggle in the sidebar",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "tailwind.config.js",
        "none_match": [
          "\\.vue",
          "ThemeToggle\\.vue"
        ],
        "contains_all": [
          "darkMode"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes",
        "\\.vue",
        "ThemeToggle\\.vue"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "tailwind.config.js",
      "contains": "darkMode"
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "any_match": [
        "toggleTheme",
        "setTheme",
        "useState"
      ]
    },
    {
      "action": "assert_message_metadata",
      "from": "FrontendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear",
  "optional": true
}
