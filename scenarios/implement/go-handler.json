{
  "name": "go-handler",
  "description": "IDE Agent implementation session on minimal Go fixture.",
  "tags": ["implement", "backend", "go"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": ["BackendEngineer"],
  "workspace": { "fixture": "minimal-repo" },
  "expect_deliverables": [
    {
      "path": "core/sample/main.go",
      "min_bytes": 40,
      "for_question": {
        "contains_all": ["HelloWorld"],
        "any_match": ["func HelloWorld", "HelloWorld\\("],
        "none_match": ["index\\.js", "utils\\.js"]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "please implement a HelloWorld function in core/sample/main.go and call it from main",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "420s",
      "until_any_match": ["applied and verified|proposals submitted|verification failed|HelloWorld"]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "any_match": ["implementation session|HelloWorld|file change|Grounding|applied and verified|proposals submitted|Proposing to edit"],
      "none_match": ["finished without file changes"]
    },
    {
      "action": "assert_file_exists",
      "path": "core/sample/main.go",
      "contains": "HelloWorld"
    }
  ],
  "cleanup": "clear"
}
