{
  "name": "tauri-make-start-all-best-of-k",
  "description": "Boot-fix with best-of-K exploration (ComPilot-style multi-run) for Makefile start-all repair.",
  "tags": [
    "implement",
    "boot-fix",
    "tauri",
    "fix-loop",
    "best-of-k"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "workspace": {
    "fixture": "react-tauri-missing-start-all"
  },
  "expect_deliverables": [
    {
      "path": "Makefile",
      "for_question": {
        "any_match": [
          "start-all:",
          "scripts/start-all.sh"
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "the app in this workspace is not booting up \u2014 make start-all fails:\n\n```\n$ make start-all\nmake: *** No rule to make target 'start-all'.  Stop.\n```\n\nPlease fix the Makefile so start-all runs scripts/start-all.sh.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "implementation_best_of_k_boot_fix": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "1800s",
      "until_file_match": {
        "path": "Makefile",
        "any_match": [
          "start-all:",
          "scripts/start-all.sh"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_message_metadata",
      "from": "FrontendEngineer",
      "optional": true,
      "require_keys": [
        "implementation_session_outcome"
      ],
      "match": {
        "implementation_session_outcome.best_of_k_total": "2"
      }
    }
  ],
  "cleanup": "clear"
}
