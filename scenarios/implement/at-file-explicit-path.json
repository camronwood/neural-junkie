{
  "name": "at-file-explicit-path",
  "description": "Scoped edit via @file:src/App.tsx only.",
  "tags": ["implement", "cursor-parity", "react", "at-file"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": {
    "fixture": "react-tailwind-minimal",
    "unchanged_files": ["tailwind.config.js", "package.json"]
  },
  "expect_deliverables": [
    {
      "path": "src/App.tsx",
      "min_bytes": 80,
      "for_question": {
        "any_match": ["subtitle|Neural Junkie|fixture"],
        "none_match": ["tailwind\\.config"]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "@FrontendEngineer In @file:src/App.tsx add a short subtitle paragraph under the sidebar heading. Do not edit tailwind.config.js or any other file.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "900s",
      "until_any_match": ["applied and verified|implementation session complete|App.tsx|subtitle"]
    },
    {
      "action": "assert_files_unchanged",
      "paths": ["tailwind.config.js", "package.json"]
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "any_match": ["subtitle|Subhead|fixture"]
    }
  ],
  "cleanup": "clear"
}
