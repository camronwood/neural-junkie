{
  "name": "go-build-error-fix",
  "description": "Fix-like flow: Go test failure fixed via repro-first session (Multiply bug in math.go). Optional soak twin \u2014 excluded from default implement --all.",
  "tags": [
    "implement",
    "fix-like",
    "go",
    "soak",
    "optional"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "BackendEngineer",
  "required_agents": [
    "BackendEngineer"
  ],
  "workspace": {
    "fixture": "go-verify-repair"
  },
  "expect_deliverables": [
    {
      "path": "core/sample/math.go",
      "for_question": {
        "any_match": [
          "func Multiply",
          "\\*"
        ],
        "none_match": [
          "return a \\+ b[^*]"
        ]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "go test ./... is failing in this workspace \u2014 please fix the bug in core/sample/math.go so tests pass.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "backend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "BackendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "core/sample/math.go",
        "any_match": [
          "func Multiply",
          "\\*"
        ],
        "none_match": [
          "return a \\+ b[^*]"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "BackendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_message_metadata",
      "from": "BackendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear",
  "optional": true
}
