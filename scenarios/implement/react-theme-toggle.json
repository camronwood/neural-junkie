{
  "name": "react-theme-toggle",
  "description": "Frontend implementation session adds darkMode to Tailwind on React fixture; rejects Vue paths.",
  "tags": ["implement", "frontend", "react"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": { "fixture": "react-tailwind-minimal" },
  "steps": [
    {
      "action": "send",
      "content": "implement light/dark theme toggle in the sidebar",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "420s",
      "until_any_match": ["applied and verified|proposals submitted|verification failed|darkMode|dark mode|implementation session"]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "any_match": ["implementation session|applied and verified|proposals submitted|darkMode|theme"],
      "none_match": ["finished without file changes", "\\.vue", "App\\.vue", "ThemeToggle\\.vue"]
    },
    {
      "action": "assert_file_exists",
      "path": "tailwind.config.js",
      "contains": "darkMode"
    }
  ],
  "cleanup": "clear"
}
