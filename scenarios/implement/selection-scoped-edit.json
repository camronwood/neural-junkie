{
  "name": "selection-scoped-edit",
  "description": "Extract selected sidebar footer block to a helper file without touching config.",
  "tags": ["implement", "cursor-parity", "react", "selection"],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": ["FrontendEngineer"],
  "workspace": {
    "fixture": "react-tailwind-minimal",
    "open_files": ["src/App.tsx"],
    "active_file": "src/App.tsx",
    "unchanged_files": ["tailwind.config.js", "package.json"],
    "selection": {
      "start_line": 4,
      "end_line": 12,
      "selected_text": "function renderSidebarFooter() {\n  return (\n    <footer className=\"text-xs text-slate-600 border-t border-slate-800 pt-3\">\n      <p>Neural Junkie fixture</p>\n      <p>Selection extract target block</p>\n      <p>Keep this helper scoped to sidebar only</p>\n      <p>Do not move theme toggle logic here</p>\n    </footer>\n  );\n}"
    }
  },
  "expect_deliverables": [
    {
      "path": "src/App.tsx",
      "min_bytes": 80,
      "for_question": {
        "any_match": ["SidebarFooter|renderSidebarFooter|import"],
        "none_match": ["\\.jsx"]
      }
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "@FrontendEngineer Extract the selected sidebar footer block from src/App.tsx into src/components/SidebarFooter.tsx and import it in App. Do not change tailwind.config.js or package.json.",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "420s",
      "until_any_match": ["applied and verified|implementation session complete|SidebarFooter|footer"],
      "until_file_exists": "src/components/SidebarFooter.tsx"
    },
    {
      "action": "assert_files_unchanged",
      "paths": ["tailwind.config.js", "package.json"]
    },
    {
      "action": "assert_file_exists",
      "path": "src/components/SidebarFooter.tsx",
      "any_match": ["footer|SidebarFooter|Neural Junkie fixture"]
    },
    {
      "action": "assert_file_exists",
      "path": "src/App.tsx",
      "any_match": ["SidebarFooter|renderSidebarFooter|import"]
    }
  ],
  "cleanup": "clear"
}
