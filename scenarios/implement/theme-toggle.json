{
  "name": "theme-toggle",
  "description": "Frontend implementation session asks for theme-related deliverable. Optional soak twin \u2014 excluded from default implement --all.",
  "tags": [
    "implement",
    "frontend",
    "soak",
    "optional"
  ],
  "channel": "implement-scenarios",
  "channel_type": "public",
  "target_agent": "FrontendEngineer",
  "required_agents": [
    "FrontendEngineer"
  ],
  "workspace": {
    "fixture": "minimal-repo"
  },
  "expect_deliverables": [
    {
      "path": "src/theme.css",
      "min_bytes": 20,
      "for_question": {
        "contains_all": [
          "dark"
        ],
        "any_match": [
          "light|data-theme|prefers-color-scheme|--dark|--bg-dark|var\\(|\\.dark"
        ]
      },
      "llm_judge": true
    }
  ],
  "steps": [
    {
      "action": "send",
      "content": "implement a simple theme.css file with light and dark variables under src/theme.css",
      "metadata": {
        "editor_mode": "agent",
        "ide_route_agent_type": "frontend",
        "implementation_session": true,
        "editor_agent_trust": "auto_apply_edits",
        "conversation_mode": "code"
      }
    },
    {
      "action": "wait_reply",
      "from": "FrontendEngineer",
      "timeout": "600s",
      "until_file_match": {
        "path": "src/theme.css",
        "any_match": [
          "light|data-theme|prefers-color-scheme|--dark|--bg-dark|var\\(|\\.dark"
        ],
        "contains_all": [
          "dark"
        ]
      },
      "until_metadata_keys": [
        "implementation_session_outcome"
      ]
    },
    {
      "action": "assert_messages",
      "from": "FrontendEngineer",
      "last_reply_only": true,
      "none_match": [
        "finished without file changes"
      ]
    },
    {
      "action": "assert_file_exists",
      "path": "src/theme.css",
      "contains": "dark"
    },
    {
      "action": "assert_message_metadata",
      "from": "FrontendEngineer",
      "require_keys": [
        "implementation_session_outcome"
      ]
    }
  ],
  "cleanup": "clear",
  "optional": true
}
