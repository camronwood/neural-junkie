{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "react-tauri-missing-start-all",
    "version": "1.0.0",
    "name": "react-tauri-missing-start-all",
    "binaries": [
      {
        "target": "x86_64-apple-darwin",
        "path": "src-tauri/target/release/react-tauri-missing-start-all.app"
      },
      {
        "target": "x86_64-pc-windows-msvc",
        "path": "src-tauri/target/release/react-tauri-missing-start-all.exe"
      },
      {
        "target": "x86_64-unknown-linux-gnu",
        "path": "src-tauri/target/release/react-tauri-missing-start-all"
      }
    ],
    "active": true
  }
}