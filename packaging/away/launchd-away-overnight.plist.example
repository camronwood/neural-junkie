<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Unattended pre-stable overnight (AWAY_GATE=full + MORNING_RC + fix-on-fail).

  Install:
    cp packaging/away/launchd-away-overnight.plist.example \
      ~/Library/LaunchAgents/com.neuraljunkie.away-overnight.plist
    # Edit WorkingDirectory to this checkout (prefer .worktrees/pre-stable-reliability)
    launchctl unload ~/Library/LaunchAgents/com.neuraljunkie.away-overnight.plist 2>/dev/null || true
    launchctl load ~/Library/LaunchAgents/com.neuraljunkie.away-overnight.plist

  Starts at 22:00 America/Chicago. Pair with launchd-away-agent.plist.example for daytime PR drain.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.neuraljunkie.away-overnight</string>
  <key>WorkingDirectory</key>
  <string>/Users/camronwood/development/projects/neural-junkie/.worktrees/pre-stable-reliability</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>overnight</string>
    <string>NJ_OVERNIGHT_TARGET=away</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>AWAY_DEADLINE_CT</key>
    <string>05:00</string>
    <key>AWAY_GATE</key>
    <string>full</string>
    <key>MORNING_RC</key>
    <string>1</string>
    <key>AWAY_FIX_ON_FAIL</key>
    <string>1</string>
    <key>AUTO_STABLE_CUT</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/nj-away-overnight.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nj-away-overnight.err.log</string>
</dict>
</plist>
