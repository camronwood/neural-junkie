# Neural Junkie Environment Configuration

# Ollama models (used by make agents / load-env.sh; keep in sync with ~/.neural-junkie/config.json)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CODE_MODEL=qwen3.5:9b

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face (hosted inference + gated model downloads)
# HF_TOKEN=hf_your_token_here

# Server Configuration
SERVER_PORT=18765
SERVER_HOST=localhost

# Hub memory / heap profiling (local only; binds pprof to loopback)
# NEURAL_JUNKIE_PACKS_CATALOG_URL=https://raw.githubusercontent.com/camronwood/neural-junkie/main/packs/catalog.json
# Domain pack zips: GitHub release assets (see docs/PACKS.md); hub falls back to embedded packs when download fails.

# NEURAL_JUNKIE_DEBUG=1 enables GET /api/debug/hub-memory and http://127.0.0.1:6060/debug/pprof/
# Dev collab/conversation debugging:
#   make server-debug          # hub + log to /tmp/nj-hub.log
#   make server-log            # tail collab lines (separate terminal)
#   make debug-session         # offline last-session.json
#   make debug-collab COLAB=ec2cdef8 CHANNEL=collab-ec2cdef8-...
#   make debug-messages CHANNEL=dm-camron-assistant TAIL=15
#   make collab-smoke              # in-process API phase test (CI / pre-release)
#   make collab-smoke LIVE=1       # live hub (needs agents for reviewing→executing)
#   make collab-scenario SCENARIO=planning-two-agent   # live agents; PROFILE=fast|realistic
#   make collab-scenario SCENARIO=resource-api-schema-planning  # needs Gemini + PlatformEngineer
#   make collab-scenarios          # all scenarios in scenarios/collab/
#   make collab-scenario-matrix    # sweep profiles and round budgets
# NEURAL_JUNKIE_SCENARIO_REPO=/path/to/Phoenix   # optional workspace for resource-api-schema-planning
# NJ_SCENARIO_ALLOW_FILE_FALLBACK=1            # dev only: allow discussion fallback when hub file-change missing
# NJ_DELIVERABLE_JUDGE_PROVIDER=gemini        # gemini | cursor | ollama (default gemini — independent cloud judge)
# NJ_DELIVERABLE_JUDGE_AGENT=Gemini           # hub agent name (default: Gemini for gemini, Cursor for cursor)
# NJ_DELIVERABLE_JUDGE_MODE=hub               # hub (DM to CLI agent) | cli (direct subprocess) | ollama
# NJ_DELIVERABLE_JUDGE_TIMEOUT=180            # seconds per deliverable judge call
# NJ_DELIVERABLE_JUDGE_SKIP=1                 # skip LLM judge during live scenario runs (regex checks only)
# NJ_DELIVERABLE_JUDGE_MODEL=qwen3.5:9b       # only when NJ_DELIVERABLE_JUDGE_PROVIDER=ollama
# Desktop workspace context: Auto (default) | Always | Off — localStorage key workspace-context-mode
#   ./scripts/debug-collab.py session --help
# NEURAL_JUNKIE_PPROF_ADDR=127.0.0.1:6060
# Parent directory for collaboration execution sandboxes (<dir>/<collaboration-id>/).
# Default when unset: ~/.neural-junkie/collaborations. Also settable as collaboration.assets_root in config.json or Settings → AI Providers.
# NEURAL_JUNKIE_COLLAB_ASSETS_DIR=~/development/collab-output

# NEURAL_JUNKIE_SKIP_SESSION_RESTORE=1  # one boot: skip ~/.neural-junkie/last-session.json (default channels only)
# NEURAL_JUNKIE_FORCE_SESSION_RESTORE=1  # dev only: load last-session.json even when >64MB (may OOM; normally auto-archived)

# MCP tool servers (Backend, DevOps, Database, BiologyExpert) are configured in
# Settings → AI & providers and ~/.neural-junkie/config.json ("mcp", "hf").
# Life sciences pack toggles Biology MCP automatically — no ENABLE_*_MCP env vars.

# MCP Resource Server Configuration
# Enable MCP resource server for accessing exported agent knowledge
ENABLE_MCP_RESOURCES=true
MCP_RESOURCES_PORT=8086

# MCP Export Storage Configuration
# Directory for storing exported agent knowledge (defaults to ~/.neural-junkie/exports)
MCP_EXPORTS_DIR=~/.neural-junkie/exports

# CLI Agent - Cursor (Optional)
# Enables a Cursor CLI-backed agent in the chat.
# Requires the Cursor CLI to be installed: curl https://cursor.com/install -fsS | bash
# Get API key from your Cursor account settings.
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_WORK_DIR=/path/to/your/project

# Confluence Cloud Configuration (Optional)
# Required for Confluence documentation agents
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_DOMAIN=yourcompany.atlassian.net
CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Google Meet notes (Assistant) — optional env override for OAuth app credentials.
# Prefer Settings → Integrations → Google Meet notes (saved on hub at ~/.neural-junkie/assistant/google_oauth_app.json).
# NEURAL_JUNKIE_GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
# NEURAL_JUNKIE_GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# NEURAL_JUNKIE_GOOGLE_OAUTH_REDIRECT_URL=http://localhost:18765/api/assistant/google/callback

# Assistant web search (Settings → Integrations → Web search)
# NEURAL_JUNKIE_WEB_SEARCH_ENABLED=1
# NEURAL_JUNKIE_WEB_SEARCH_PROVIDER=tavily
# NEURAL_JUNKIE_WEB_SEARCH_API_KEY=tvly-...
# NEURAL_JUNKIE_WEB_SEARCH_KEYLESS=1
# Brave (requires API key + card for free credits): NEURAL_JUNKIE_WEB_SEARCH_PROVIDER=brave

# Slack Connect (dev overrides; release builds embed vendor/oauth.json)
# NEURAL_JUNKIE_SLACK_CLIENT_ID=your_slack_client_id
# NEURAL_JUNKIE_SLACK_CLIENT_SECRET=your_slack_client_secret
# NEURAL_JUNKIE_SLACK_APP_TOKEN=xapp-your_app_token
# NEURAL_JUNKIE_SLACK_OAUTH_RELAY_BASE=https://nj-slack-oauth-relay.YOUR_SUBDOMAIN.workers.dev
# NEURAL_JUNKIE_SLACK_REDIRECT_URL=https://your-relay.example/api/slack/oauth/callback
# NEURAL_JUNKIE_SLACK_USE_OAUTH_RELAY=1


